{# @var \Setono\SyliusRestockNotificationPlugin\Model\NotificationInterface data #}
{% set variant = data.productVariant %}
{% set product = variant.product %}
<strong>{{ product.name }}</strong> [<a href="{{ path('sylius_shop_product_show', {'slug' : product.slug, '_locale': data.locale.code}) }}" target="_blank">{{ 'sylius.ui.show'|trans }}</a>]<br>
{% if variant.optionValues|length > 0 %}
    <ul style="padding: 0; margin: 0; list-style-position: inside">
        {% for option_value in variant.optionValues %}
            <li>{{ option_value.name }}: {{ option_value.value }}</li>
        {% endfor %}
    </ul>
{% else %}
    {{ variant.name }}
{% endif %}
