<div class="ui two column grid">
    <div class="ten wide column">
        {{ form_row(form.channel) }}
        {{ form_row(form.locale) }}
        {{ form_row(form.productVariant, {
            'remote_url': path('setono_sylius_restock_notification_admin_ajax_product_variant_by_phrase'),
            'load_edit_url': path('setono_sylius_restock_notification_admin_ajax_product_variant_by_code'),
        })}}
        {{ form_row(form.email) }}
    </div>
    <div class="six wide column">
        <div class="ui info message">
            <div class="header">
                {{ 'setono_sylius_restock_notification.form.restock_notification_request.help.header'|trans }}
            </div>
            {{ 'setono_sylius_restock_notification.form.restock_notification_request.help.content'|trans|raw }}
        </div>
    </div>
</div>
