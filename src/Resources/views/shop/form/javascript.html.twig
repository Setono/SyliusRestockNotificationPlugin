<script>
    class SSRNManager {
        #options;

        /**
         * @type {SSRNSelect[]}
         */
        #selects = [];

        constructor(options) {
            if(document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => {
                    this.#init(options);
                });
            } else {
                this.#init(options);
            }
        }

        #init(options) {
            this.#options = Object.assign({
                    selector: '.ssrn-select',
                },
                options
            );

            document.querySelectorAll(this.#options.selector).forEach(select => {
                this.#selects.push(new SSRNSelect(select));
            });
        }
    }

    class SSRNSelect {
        /**
         * @type {HTMLSelectElement}
         */
        #select;

        /**
         * A hidden input element
         *
         * @type {HTMLInputElement}
         */
        #form;

        /**
         * @type {HTMLElement}
         */
        #trigger;

        /**
         * @type {NodeListOf<HTMLElement>}
         */
        #options;

        /**
         * @param select {HTMLSelectElement}
         */
        constructor(select) {
            this.#select = select;
            this.#form = document.getElementById(this.#select.dataset.form);
            this.#trigger = select.querySelector('.ssrn-select-trigger');
            this.#options = select.querySelectorAll('.ssrn-option');

            // Toggle select on trigger click
            this.#trigger.addEventListener('click', () => {
                this.#select.classList.toggle('opened');
            });

            // Close select when clicking outside
            document.addEventListener('click', (event) => {
                if (!this.#select.contains(event.target)) {
                    this.#select.classList.remove('opened');
                }
            });

            // Option selection
            this.#options.forEach((option) => {
                option.addEventListener('click', (e) => {
                    // Update trigger text
                    this.#trigger.textContent = e.target.textContent;

                    // Remove selection class from all options
                    this.#options.forEach(function (opt) {
                        opt.classList.remove('selection');
                    });

                    // Add selection class to selected option
                    e.currentTarget.classList.add('selection');

                    // Update hidden input value
                    this.#form.value = e.target.getAttribute('data-value');

                    // Trigger change event on hidden input
                    this.#form.dispatchEvent(new Event('change', { bubbles: true }));

                    // Close dropdown
                    this.#select.classList.remove('opened');
                });
            });
        }
    }

    new SSRNManager();
</script>
