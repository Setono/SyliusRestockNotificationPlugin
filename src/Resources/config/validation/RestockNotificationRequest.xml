<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd"
>
    <class name="Setono\SyliusRestockNotificationPlugin\Model\RestockNotificationRequest">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">
                <value>productVariant</value>
                <value>email</value>
            </option>
            <option name="groups">setono_sylius_restock_notification</option>
        </constraint>
        <property name="channel">
            <constraint name="NotBlank">
                <option name="groups">setono_sylius_restock_notification</option>
            </constraint>
        </property>
        <property name="locale">
            <constraint name="NotBlank">
                <option name="groups">setono_sylius_restock_notification</option>
            </constraint>
        </property>
        <property name="productVariant">
            <constraint name="NotBlank">
                <option name="groups">setono_sylius_restock_notification</option>
            </constraint>
        </property>
        <property name="email">
            <constraint name="NotBlank">
                <option name="groups">setono_sylius_restock_notification</option>
            </constraint>
            <constraint name="Email">
                <option name="groups">setono_sylius_restock_notification</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
