{
    "name": "setono/sylius-restock-notification-plugin",
    "type": "sylius-plugin",
    "description": "Plugin that allows customer to sign up for notifications when a product is back in stock",
    "license": "MIT",
    "require": {
        "php": "^7.2",
        "doctrine/common": "^2.0",
        "doctrine/orm": "^2.7",
        "doctrine/persistence": "^1.3",
        "knplabs/knp-menu": "^3.1",
        "sylius/channel": "^1.0",
        "sylius/channel-bundle": "^1.0",
        "sylius/core": "^1.0",
        "sylius/inventory": "^1.0",
        "sylius/locale": "^1.0",
        "sylius/locale-bundle": "^1.0",
        "sylius/product": "^1.0",
        "sylius/resource-bundle": "^1.0",
        "symfony/config": "^4.4 || ^5.0",
        "symfony/dependency-injection": "^4.4 || ^5.0",
        "symfony/form": "^4.4 || ^5.0",
        "symfony/framework-bundle": "^4.4 || ^5.0",
        "symfony/http-foundation": "^4.4 || ^5.0",
        "symfony/http-kernel": "^4.4 || ^5.0",
        "symfony/messenger": "^4.4 || ^5.0",
        "symfony/options-resolver": "^4.4 || ^5.0",
        "symfony/routing": "^4.4 || ^5.0",
        "symfony/translation-contracts": "^1.0 || ^2.0",
        "symfony/workflow": "^4.4 || ^5.0",
        "thecodingmachine/safe": "^1.1",
        "twig/twig": "^2.0 || ^3.0",
        "webmozart/assert": "^1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.3",
        "korbeil/phpstan-generic-rules": "^0.2.4",
        "phpspec/phpspec": "^6.1",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^0.12",
        "phpstan/phpstan-doctrine": "^0.12",
        "phpstan/phpstan-strict-rules": "^0.12.2",
        "phpstan/phpstan-webmozart-assert": "^0.12",
        "phpunit/phpunit": "^8.5",
        "roave/security-advisories": "dev-master",
        "setono/sylius-variant-link-plugin": "^0.2.0",
        "sspooky13/yaml-standards": "^5.1",
        "sylius-labs/coding-standard": "^3.1",
        "sylius/sylius": "^1.0",
        "symfony/browser-kit": "^4.4 || ^5.0",
        "symfony/debug-bundle": "^4.4 || ^5.0",
        "symfony/dotenv": "^4.4 || ^5.0",
        "symfony/intl": "^4.4 || ^5.0",
        "symfony/web-profiler-bundle": "^4.4 || ^5.0",
        "symfony/web-server-bundle": "^4.4 || ^5.0",
        "thecodingmachine/phpstan-safe-rule": "^1.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Setono\\SyliusRestockNotificationPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Setono\\SyliusRestockNotificationPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "prefer-stable": true,
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon -l max src/",
        "check-style": "vendor/bin/ecs check src/ tests/ spec/",
        "check-yaml": "vendor/bin/yaml-standards",
        "fix-style": "vendor/bin/ecs check src/ tests/ spec/ --fix",
        "phpspec": "vendor/bin/phpspec run",
        "phpunit": "vendor/bin/phpunit"
    }
}
